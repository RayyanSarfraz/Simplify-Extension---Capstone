{
  "name": "simplify-extension",
  "displayName": "Simplify Unit Test Generator",
  "description": "Generates and runs Jest tests via deepseek-coder:6.7b for any workspace folder",
  "version": "0.0.4",
  "publisher": "your-publisher",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onCommand:simplify.runTests"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplify.runTests",
        "title": "Run Unit Tests"
      }
    ]
  },
  "scripts": {
    "test": "jest --watchAll"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.99.0",
    "jest": "^29.7.0"
  }
}
