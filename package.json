{
  "name": "simplify-extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onView:simplifySidebar",
    "onCommand:simplify.runTests"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplify.runTests",
        "title": "Run Unit Tests"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simplifySidebar",
          "title": "Unit Test AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "simplifySidebar": [
        {
          "id": "unitTestSidebar",
          "name": "Tests"
        }
      ]
    }
  },
  "scripts": {
    "test": "mocha test.js"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "assert": "^2.0.0",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "mocha": "^10.0.0"
  },
  "description": "This is the README for your extension \"Simplify-Extension\". After writing up a brief description, we recommend including the following sections.",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RayyanSarfraz/Simplify-Extension---Capstone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RayyanSarfraz/Simplify-Extension---Capstone/issues"
  },
  "homepage": "https://github.com/RayyanSarfraz/Simplify-Extension---Capstone#readme"
}
